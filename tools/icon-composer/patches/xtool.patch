diff --git a/Sources/PackLib/CompiledAppIcon.swift b/Sources/PackLib/CompiledAppIcon.swift
new file mode 100644
index 0000000..04a4053
--- /dev/null
+++ b/Sources/PackLib/CompiledAppIcon.swift
@@ -0,0 +1,43 @@
+import AssetKit
+import Foundation
+
+/// Resource bytes and plist declarations travel together throughout packing.
+struct CompiledAppIcon: Sendable {
+    let result: CompileResult
+
+    func validate(resources: [Plan.Resource]) throws {
+        let reserved = Set(["Assets.car"] + (result.appIconBundle?.looseFiles.map(\.name) ?? []))
+        for resource in resources {
+            if case .root(let source) = resource,
+               reserved.contains(URL(fileURLWithPath: source).lastPathComponent) {
+                throw StringError(
+                    "Icon Composer output conflicts with resource '\(source)'; catalog merging is not supported yet."
+                )
+            }
+        }
+    }
+
+    func write(to directory: URL) throws {
+        try Task.checkCancellation()
+        try result.carData.write(to: directory.appendingPathComponent("Assets.car"), options: .atomic)
+        for file in result.appIconBundle?.looseFiles ?? [] {
+            try Task.checkCancellation()
+            try file.data.write(to: directory.appendingPathComponent(file.name), options: .atomic)
+        }
+    }
+
+    func update(plist: inout [String: any Sendable]) {
+        guard let bundle = result.appIconBundle else { return }
+        for (key, value) in bundle.infoPlistAdditions {
+            if let additions = value as? [String: any Sendable],
+               var existing = plist[key] as? [String: any Sendable] {
+                // Preserve alternate-icon entries from the supplied plist.
+                existing.merge(additions) { _, generated in generated }
+                plist[key] = existing
+            } else {
+                plist[key] = value
+            }
+        }
+        plist.removeValue(forKey: "CFBundleIconFile")
+    }
+}
diff --git a/Sources/PackLib/IconCompilerClient.swift b/Sources/PackLib/IconCompilerClient.swift
new file mode 100644
index 0000000..6da2a47
--- /dev/null
+++ b/Sources/PackLib/IconCompilerClient.swift
@@ -0,0 +1,22 @@
+import AssetKit
+import Dependencies
+import Foundation
+
+/// Compiling the icon once yields both the resource bytes and plist metadata.
+/// A dependency override can provide another compiler without changing Packer.
+struct IconCompilerClient: Sendable {
+    var compile: @Sendable (_ directory: URL, _ deploymentTarget: String) async throws -> CompileResult
+}
+
+extension IconCompilerClient: DependencyKey {
+    static let liveValue = Self { directory, deploymentTarget in
+        try await IconCompiler(deploymentTarget: deploymentTarget).compile(icon: directory)
+    }
+}
+
+extension DependencyValues {
+    var iconCompiler: IconCompilerClient {
+        get { self[IconCompilerClient.self] }
+        set { self[IconCompilerClient.self] = newValue }
+    }
+}
