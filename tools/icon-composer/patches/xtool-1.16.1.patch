+    private func writeInfo(for product: Plan.Product, icon: CompiledAppIcon?, outputURL: URL) throws {
+        var info = product.infoPlist
+        if product.type == .application {
+            info["UIRequiredDeviceCapabilities"] = ["arm64"]
+            info["LSRequiresIPhoneOS"] = true
+            info["CFBundleSupportedPlatforms"] = ["iPhoneOS"]
         }
+        if let icon {
+            icon.update(plist: &info)
+        } else if let path = product.iconPath {
+            info["CFBundleIconFile"] = URL(fileURLWithPath: path).deletingPathExtension().lastPathComponent
+        }
+        let encoded = try PropertyListSerialization.data(fromPropertyList: info, format: .xml, options: 0)
