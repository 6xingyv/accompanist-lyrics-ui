@@ -0,0 +1,85 @@
+import Foundation
+
+/// Compiles an Icon Composer `.icon` directory into an iOS asset catalog.
+///
+/// This is an experimental CoreUI 975 writer. It preserves image sources,
+/// layer order, fills, and group material parameters instead of flattening
+/// the iOS 26 icon into a PNG. Unsupported document fields are errors.
+/// Legacy PNGs are flat artwork fallbacks; they do not reproduce CoreUI's
+/// dynamic glass lighting. See docs/icon-composer.md for the supported schema.
+public struct IconCompiler: Sendable {
+    public var deploymentTarget: String
+    public var svgRasterizer: any SVGRasterizer
+    public var includeLegacyFallbacks: Bool
+
+    public init(
+        deploymentTarget: String,
+        svgRasterizer: any SVGRasterizer = RsvgConvertRasterizer(),
+        includeLegacyFallbacks: Bool = true
+    ) {
+        self.deploymentTarget = deploymentTarget
+        self.svgRasterizer = svgRasterizer
+        self.includeLegacyFallbacks = includeLegacyFallbacks
+    }
+
+    public func compile(icon directory: URL) async throws -> CompileResult {
+        try Task.checkCancellation()
+        guard directory.pathExtension.lowercased() == "icon" else {
+            throw IconCompilerError.invalidDocument("Expected a .icon directory")
+        }
+        let name = directory.deletingPathExtension().lastPathComponent
+        guard !name.isEmpty, name.utf8.count <= 64, !name.contains("\0") else {
+            throw IconCompilerError.invalidDocument("Icon name must contain 1...64 UTF-8 bytes and no NUL")
+        }
+        let document: IconDocument
+        do {
+            let bytes = try Data(contentsOf: directory.appendingPathComponent("icon.json"))
+            document = try JSONDecoder().decode(IconDocument.self, from: bytes)
+        } catch let error as DecodingError {
+            throw IconCompilerError.invalidDocument(String(describing: error))
+        }
+        let source = try IconSource.load(document: document, directory: directory)
+        var builder = IconCatalogBuilder(name: name)
+        try builder.build(document: document, source: source)
+        try Task.checkCancellation()
+        let car = try IconCARWriter(
+            deploymentTarget: deploymentTarget, assets: builder.assets, records: builder.records
+        ).write()
+        let looseFiles = includeLegacyFallbacks
+            ? try IconFallbackRenderer.render(document: document, source: source, name: name, rasterizer: svgRasterizer)
+            : []
+        return CompileResult(carData: car, appIconBundle: Self.bundle(name: name, looseFiles: looseFiles))
+    }
+
+    private static func bundle(name: String, looseFiles: [LooseFile]) -> AppIconBundle {
+        let iphoneFiles = looseFiles.isEmpty ? [] : ["\(name)60x60"]
+        let ipadFiles = looseFiles.isEmpty ? [] : ["\(name)76x76", "\(name)83.5x83.5"]
+        let primary: @Sendable ([String]) -> [String: any Sendable] = { files in
+            var info: [String: any Sendable] = ["CFBundleIconName": name]
+            if !files.isEmpty { info["CFBundleIconFiles"] = files }
+            return ["CFBundlePrimaryIcon": info]
+        }
+        return AppIconBundle(primaryIconName: name, infoPlistAdditions: [
+            "CFBundleIconName": name,
+            "CFBundleIcons": primary(iphoneFiles),
+            "CFBundleIcons~ipad": primary(ipadFiles),
+            "CFBundleIconFiles": iphoneFiles + ipadFiles
+        ], looseFiles: looseFiles)
+    }
+}
+
+public enum IconCompilerError: Error, Sendable, CustomStringConvertible {
+    case invalidDocument(String)
+    case unsupported(String)
+    case invalidAsset(String)
+    case rasterizationFailed(String)
+
+    public var description: String {
+        switch self {
+        case .invalidDocument(let detail): "Invalid Icon Composer document: \(detail)"
+        case .unsupported(let detail): "Unsupported Icon Composer feature: \(detail)"
+        case .invalidAsset(let detail): "Invalid Icon Composer asset: \(detail)"
+        case .rasterizationFailed(let detail): "Icon fallback rasterization failed: \(detail)"
+        }
+    }
+}
diff --git a/Sources/AssetKit/IconComposer/IconCARWriter.swift b/Sources/AssetKit/IconComposer/IconCARWriter.swift
new file mode 100644
index 0000000..6764694
--- /dev/null
+++ b/Sources/AssetKit/IconComposer/IconCARWriter.swift
@@ -0,0 +1,282 @@
+import Foundation
+
+/// Icon Composer uses the same BOM/CSI container as asset catalogs, but its
+/// lookup parts and variable-length layer records differ. Keep those details
+/// here rather than changing the existing imageset writer's wire format.
+enum IconPart: UInt16 {
+    case image = 181
+    case color = 217
+    case stack = 245
+    case group = 246
+    case gradient = 247
+}
+
+struct IconAsset: Sendable {
+    let name: String
+    let identifier: UInt16
+    let part: IconPart
+}
+
+/// KEYFORMAT and BITMAPKEYS describe the same ordered attributes. Keep their
+/// schema together so changing the key format cannot leave a stale descriptor.
+enum IconKeyFormat {
+    struct Attribute: Sendable {
+        let id: UInt32
+        let descriptorToken: UInt32
+    }
+
+    static let attributes: [Attribute] = [
+        .init(id: 7, descriptorToken: .max),
+        .init(id: 13, descriptorToken: 1),
+        .init(id: 12, descriptorToken: 2),
+        .init(id: 15, descriptorToken: 1),
+        .init(id: 16, descriptorToken: 1),
+        .init(id: 8, descriptorToken: 1),
+        .init(id: 24, descriptorToken: 1),
+        .init(id: 17, descriptorToken: .max),
+        .init(id: 1, descriptorToken: .max),
+        .init(id: 2, descriptorToken: .max)
+    ]
+
+    static func bitmapDescriptor() -> Data {
+        var writer = ByteWriter()
+        writer.writeLE(UInt32(1))
+        writer.writeLE(UInt32(0))
+        writer.writeLE(UInt32((attributes.count + 1) * 4))
+        writer.writeLE(UInt32(attributes.count))
+        for attribute in attributes { writer.writeLE(attribute.descriptorToken) }
+        return writer.data
+    }
+}
+
+struct IconRecord: Sendable {
+    let asset: IconAsset
+    var appearance: UInt16 = 0
+    var scale: UInt16 = 1
+    let data: Data
+
+    var key: Data {
+        var writer = ByteWriter()
+        let tokens: [UInt32: UInt16] = [
+            7: appearance, 12: scale, 17: asset.identifier, 1: 85, 2: asset.part.rawValue
+        ]
+        for attribute in IconKeyFormat.attributes {
+            writer.writeLE(tokens[attribute.id, default: 0])
+        }
+        return writer.data
+    }
+}
+
+struct IconLayerReference: Sendable {
+    let asset: IconAsset
+    var frame: IconFrame = .zero
+    var blendMode: UInt32 = 0
+    var opacity: Double = 1
+    var lighting: UInt32 = 0
+    var glass = false
+    var blur: Double = 0
+    var fillName = ""
+    var specular = false
+    var translucency: Double = 0
+    var shadowKind: UInt32 = 0
+    var shadowOpacity: Double = 0
+}
+
+struct IconFrame: Sendable {
+    let x: Int32
+    let y: Int32
+    let width: UInt32
+    let height: UInt32
+    static let zero = IconFrame(x: 0, y: 0, width: 0, height: 0)
+}
+
+enum IconCSIWriter {
+    static func layers(name: String, references: [IconLayerReference], isStack: Bool) -> Data {
+        var geometry = ByteWriter()
+        geometry.writeLE(UInt32(references.count))
+        geometry.writeLE(UInt32(0))
+        var lighting = ByteWriter()
+        lighting.writeLE(UInt32(references.count))
+        lighting.writeLE(UInt32(0)) // table-level reserved word
+        var material = ByteWriter()
+        material.writeLE(UInt32(references.count))
+        material.writeLE(UInt32(0)) // table-level reserved word
+
+        for reference in references {
+            geometry.writeLE(UInt32(0))
+            geometry.writeLE(UInt32(bitPattern: reference.frame.x))
+            geometry.writeLE(UInt32(bitPattern: reference.frame.y))
+            geometry.writeLE(reference.frame.width)
+            geometry.writeLE(reference.frame.height)
+            geometry.writeLE(reference.blendMode)
+            geometry.writeLE(Float(reference.opacity).bitPattern)
+            geometry.writeLE(UInt32(16))
+            writeAssetKey(reference.asset, into: &geometry)
+            geometry.writeLE(UInt32(0)) // sparse-key terminator
+
+            // The first word selects group lighting or image glass. The
+            // reserved word belongs to the table, not to each image entry.
+            lighting.writeLE(reference.asset.part == .group
+                ? reference.lighting : UInt32(reference.glass ? 1 : 0))
+            lighting.writeLE(Float(reference.blur).bitPattern)
+            writeString(reference.fillName, into: &lighting)
+
+            material.writeLE(UInt32(reference.specular ? 1 : 0))
+            material.writeLE(Float(reference.translucency).bitPattern)
+            material.writeLE(reference.shadowKind)
+            material.writeLE(Float(reference.shadowOpacity).bitPattern)
+            material.writeLE(UInt32(0))
+        }
+
+        var tvl = ByteWriter()
+        writeTLV(1012, geometry.data, into: &tvl)
+        writeTLV(1020, lighting.data, into: &tvl)
+        writeTLV(1021, material.data, into: &tvl)
+        tvl.write(CSITVL.encode([.sliceScale]))
+        if isStack {
+            var uti = ByteWriter()
+            uti.writeLE(UInt32(20))
+            uti.writeLE(UInt32(0))
+            uti.write(Data("public.layeredimage\0".utf8))
+            writeTLV(1005, uti.data, into: &tvl)
+        }
+        tvl.write(CSITVL.encode([.bitmapFlag]))
+        return record(
+            name: name, layout: isStack ? .iconStack : .iconGroup,
+            pixelFormat: 0x44415441,
+            width: isStack ? 1024 : 0, height: isStack ? 1024 : 0,
+            scaleFactor: 100, tvl: tvl.data,
+            body: DWAREnvelope.encode(flags: 0, payload: [])
+        )
+    }
+
+    static func color(name: String, color: IconColor) -> Data {
+        var payload = ByteWriter()
+        payload.writeLE(UInt32(0x434F4C52)) // COLR, stored as RLOC
+        payload.writeLE(UInt32(1))
+        payload.writeLE(color.colorSpace)
+        payload.writeLE(UInt32(color.components.count))
+        for component in color.components { payload.writeLE(component.bitPattern) }
+        return record(name: name, layout: .namedColor, body: payload.data)
+    }
+
+    static func gradient(name: String, colors: [String], orientation: IconOrientation, automatic: Bool) -> Data {
+        var payload = ByteWriter()
+        payload.writeLE(UInt32(0x47475241)) // GGRA, stored as ARGG
+        payload.writeLE(UInt32(colors.count))
+        payload.writeLE(UInt32(automatic ? 0 : 1))
+        payload.writeLE(UInt32(0))
+        for coordinate in [orientation.start.x, orientation.start.y, orientation.stop.x, orientation.stop.y] {
+            payload.writeLE(Float(coordinate).bitPattern)
+        }
+        for (index, colorName) in colors.enumerated() {
+            let location = colors.count == 1 ? 0 : Float(index) / Float(colors.count - 1)
+            payload.writeLE(location.bitPattern)
+            writeString(colorName, into: &payload)
+        }
+        return record(name: name, layout: .namedGradient, body: payload.data)
+    }
+
+    private static func record(
+        name: String, layout: CSIHeader.Layout, pixelFormat: UInt32 = 0,
+        width: UInt32 = 0, height: UInt32 = 0, scaleFactor: UInt32 = 0,
+        tvl: Data? = nil, body: Data
+    ) -> Data {
+        // Named colors/gradients have sliceScale=(0, 0), unlike image/group
+        // renditions whose scale is 1. Do not reuse TVLEntry.sliceScale here.
+        let metadata: Data
+        if let tvl {
+            metadata = tvl
+        } else {
+            var writer = ByteWriter()
+            writeTLV(1004, Data(repeating: 0, count: 8), into: &writer)
+            writer.write(CSITVL.encode([.bitmapFlag]))
+            metadata = writer.data
+        }
+        return CSIHeader.encode(
+            renditionFlags: 0, width: width, height: height, scaleFactor: scaleFactor,
+            pixelFormat: pixelFormat, colorSpace: 0, layout: layout, name: name,
+            tvlLength: UInt32(metadata.count), bitmapCount: 1, renditionLength: UInt32(body.count)
+        ) + metadata + body
+    }
+
+    private static func writeAssetKey(_ asset: IconAsset, into writer: inout ByteWriter) {
+        for (attribute, value): (UInt16, UInt16) in [(1, 85), (2, asset.part.rawValue), (17, asset.identifier)] {
+            writer.writeLE(attribute)
+            writer.writeLE(value)
+        }
+    }
+
+    private static func writeString(_ string: String, into writer: inout ByteWriter) {
+        let bytes = Data((string + "\0").utf8)
+        writer.writeLE(UInt32(bytes.count))
+        writer.write(bytes)
+    }
+
+    private static func writeTLV(_ type: UInt32, _ payload: Data, into writer: inout ByteWriter) {
+        writer.writeLE(type)
+        writer.writeLE(UInt32(payload.count))
+        writer.write(payload)
+    }
+}
+
+struct IconCARWriter {
+    let deploymentTarget: String
+    let assets: [IconAsset]
+    let records: [IconRecord]
+
+    func write() throws -> Data {
+        // The shared BOM writer currently supports a single leaf. Reject
+        // overflow explicitly instead of writing a leaf larger than its block.
+        guard assets.count <= 126, records.count <= 510 else {
+            throw IconCompilerError.unsupported("Icon exceeds the current single-leaf BOM limit")
+        }
+        let keys = records.map(\.key)
+        guard Set(keys).count == keys.count else {
+            throw IconCompilerError.invalidDocument("Duplicate CoreUI rendition keys")
+        }
+        var bom = BOMWriter()
+        let header = CARHeaderBlock.data(
+            coreuiVersion: 975, renditionCount: UInt32(records.count),
+            mainVersionString: "@(#)PROGRAM:CoreUI  PROJECT:CoreUI-975",
+            versionString: "AssetKit Icon Composer compiler"
+        )
+        bom.setVariable("CARHEADER", blockID: bom.addBlock(header))
+        let renditionTree = BOMTree.insert(into: &bom, entries: records.map { .init(key: $0.key, value: $0.data) })
+        bom.setVariable("RENDITIONS", blockID: renditionTree)
+        let facetTree = BOMTree.insert(into: &bom, entries: assets.map { asset in
+            var value = ByteWriter()
+            value.writeLE(UInt32(0)) // cursor hotspot
+            value.writeLE(UInt16(3))
+            for (attribute, token): (UInt16, UInt16) in [(1, 85), (2, asset.part.rawValue), (17, asset.identifier)] {
+                value.writeLE(attribute)
+                value.writeLE(token)
+            }
+            return .init(key: Data(asset.name.utf8), value: value.data)
+        })
+        bom.setVariable("FACETKEYS", blockID: facetTree)
+        let appearanceTree = BOMTree.insert(into: &bom, entries: [
+            appearance("UIAppearanceAny", id: 0), appearance("UIAppearanceDark", id: 1),
+            appearance("UIAppearanceLight", id: 4), appearance("ISAppearanceTintable", id: 10)
+        ])
+        bom.setVariable("APPEARANCEKEYS", blockID: appearanceTree)
+        var format = ByteWriter()
+        format.writeLE(KeyFormatBlock.magic)
+        format.writeLE(UInt32(0))
+        format.writeLE(UInt32(IconKeyFormat.attributes.count))
+        for attribute in IconKeyFormat.attributes { format.writeLE(attribute.id) }
+        bom.setVariable("KEYFORMAT", blockID: bom.addBlock(format.data))
+        bom.setVariable("EXTENDED_METADATA", blockID: bom.addBlock(ExtendedMetadata.data(deploymentTarget: deploymentTarget)))
+        let bitmapTree = BOMTree.insertInlineKey(into: &bom, entries: assets.map { asset in
+            .init(key: UInt32(asset.identifier), value: IconKeyFormat.bitmapDescriptor())
+        }, blockSize: 1024)
+        bom.setVariable("BITMAPKEYS", blockID: bitmapTree)
+        return bom.finalize()
+    }
+
+    private func appearance(_ name: String, id: UInt16) -> BOMTree.Entry {
+        var writer = ByteWriter()
+        writer.writeLE(id)
+        return .init(key: Data(name.utf8), value: writer.data)
+    }
+}
