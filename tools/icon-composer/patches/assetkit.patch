new file mode 100644
index 0000000..25a7222
--- /dev/null
+++ b/Sources/AssetKit/IconComposer/IconCatalogBuilder.swift
@@ -0,0 +1,151 @@
+import Foundation
+
+/// Lowers the document into explicit named CoreUI assets. Asset IDs are local
+/// to the catalog; all facet keys and layer references use the same allocator.
+struct IconCatalogBuilder {
+    let name: String
+    private(set) var assets: [IconAsset] = []
+    private(set) var records: [IconRecord] = []
+    private var identifiers: Set<UInt16> = []
+    private var colorCount = 0
+    private var gradientCount = 0
+    private var colors: [IconColor: IconAsset] = [:]
+    private var gradients: [GradientKey: IconAsset] = [:]
+
+    private struct GradientKey: Hashable {
+        let colors: [IconColor]
+        let orientation: IconOrientation
+        let automatic: Bool
+    }
+
+    init(name: String) { self.name = name }
+
+    mutating func build(document: IconDocument, source: IconSource) throws {
+        let root = try asset(name: name, part: .stack)
+        var groups: [(IconGroup, IconAsset, [(IconLayer, IconAsset)])] = []
+        var imageAssets: [String: IconAsset] = [:]
+        for (index, group) in document.groups.enumerated() {
+            let groupAsset = try asset(name: "\(name)/Group-\(index + 1)", part: .group)
+            var layers: [(IconLayer, IconAsset)] = []
+            for layer in group.layers {
+                let imageAsset: IconAsset
+                if let existing = imageAssets[layer.imageName] {
+                    imageAsset = existing
+                } else {
+                    imageAsset = try asset(name: "\(name)_Assets/Image-\(imageAssets.count + 1)", part: .image)
+                    imageAssets[layer.imageName] = imageAsset
+                    let image = try source.image(named: layer.imageName)
+                    let body = PreservedSourceBody(format: .svg, sourceData: image.data, renditionName: "image.svg")
+                    records.append(IconRecord(asset: imageAsset, data: CSIWriter.preservedSource(body: body, scaleFactor: 0)))
+                }
+                layers.append((layer, imageAsset))
+            }
+            groups.append((group, groupAsset, layers))
+        }
+
+        for appearance in IconAppearance.allCases {
+            try Task.checkCancellation()
+            let background = try backgroundFill(document: document, appearance: appearance)
+            let backgroundAsset = try fill(background, requiresGradient: true)
+            var rootLayers = [IconLayerReference(asset: backgroundAsset)]
+            // Composer stores front-to-back; CoreUI stores back-to-front.
+            for (group, groupAsset, layers) in groups.reversed() {
+                var groupLayers: [IconLayerReference] = []
+                for (layer, imageAsset) in layers.reversed() {
+                    let fillValue = resolve(layer.fill, specializations: layer.fillSpecializations, appearance: appearance)
+                    let fillName = try fillValue.map { try fill($0).name } ?? ""
+                    let frame = try source.image(named: layer.imageName).frame(position: layer.style.position)
+                    groupLayers.append(IconLayerReference(
+                        asset: imageAsset, frame: frame, blendMode: layer.style.blendMode,
+                        opacity: layer.style.opacity, glass: layer.glass, fillName: fillName
+                    ))
+                }
+                records.append(IconRecord(
+                    asset: groupAsset, appearance: appearance.coreUIID,
+                    data: IconCSIWriter.layers(name: "IconGroup", references: groupLayers, isStack: false)
+                ))
+                rootLayers.append(IconLayerReference(
+                    asset: groupAsset, blendMode: group.style.blendMode, opacity: group.style.opacity,
+                    lighting: group.lighting, blur: group.blur, specular: group.specular,
+                    translucency: group.translucency?.enabled == true ? group.translucency?.value ?? 0 : 0,
+                    shadowKind: group.shadow?.kind ?? 0, shadowOpacity: group.shadow?.opacity ?? 0
+                ))
+            }
+            records.append(IconRecord(
+                asset: root, appearance: appearance.coreUIID,
+                data: IconCSIWriter.layers(name: "\(name).iconstack", references: rootLayers, isStack: true)
+            ))
+        }
+    }
+
+    private mutating func asset(name: String, part: IconPart) throws -> IconAsset {
+        guard name.utf8.count < 128, !assets.contains(where: { $0.name == name }), assets.count < 126 else {
+            throw IconCompilerError.invalidDocument("Too many assets, duplicate asset, or name exceeds CSI limit: \(name)")
+        }
+        // Collision resolution is necessary: the on-disk identifier is only
+        // 16 bits. Never emit colliding lookup keys for two different assets.
+        var identifier = UInt16(truncatingIfNeeded: FacetKeys.nameHash(name))
+        while identifier == 0 || identifiers.contains(identifier) { identifier &+= 1 }
+        identifiers.insert(identifier)
+        let asset = IconAsset(name: name, identifier: identifier, part: part)
+        assets.append(asset)
+        return asset
+    }
+
+    private mutating func color(_ color: IconColor) throws -> IconAsset {
+        if let existing = colors[color] { return existing }
+        colorCount += 1
+        let asset = try asset(name: "\(name)_Assets/Color-\(colorCount)", part: .color)
+        records.append(IconRecord(asset: asset, data: IconCSIWriter.color(name: asset.name, color: color)))
+        colors[color] = asset
+        return asset
+    }
+
+    private mutating func fill(_ fill: IconFill, requiresGradient: Bool = false) throws -> IconAsset {
+        let colors: [IconColor]
+        let orientation: IconOrientation
+        let automatic: Bool
+        switch fill {
+        case .color(let value):
+            if !requiresGradient { return try color(value) }
+            colors = [value]; orientation = .vertical; automatic = true
+        case .linearGradient(let values, let direction):
+            colors = values; orientation = direction; automatic = false
+        case .automaticGradient(let value):
+            colors = [value]; orientation = .vertical; automatic = true
+        case .systemDark:
+            // These two grayscale stops are emitted by CoreUI 975 for
+            // Icon Composer's system-dark fill.
+            colors = [.init(gray: 0.19200000166893005), .init(gray: 0.07800000160932541)]
+            orientation = .vertical; automatic = false
+        case .automatic:
+            throw IconCompilerError.unsupported("Automatic layer fill requires an explicit color or gradient")
+        }
+        let key = GradientKey(colors: colors, orientation: orientation, automatic: automatic)
+        if let existing = gradients[key] { return existing }
+        var names: [String] = []
+        for value in colors { names.append(try color(value).name) }
+        gradientCount += 1
+        let asset = try asset(name: "\(name)_Assets/Gradient-\(gradientCount)", part: .gradient)
+        records.append(IconRecord(asset: asset, data: IconCSIWriter.gradient(
+            name: asset.name, colors: names, orientation: orientation, automatic: automatic
+        )))
+        gradients[key] = asset
+        return asset
+    }
+}
+
+func backgroundFill(document: IconDocument, appearance: IconAppearance) throws -> IconFill {
+    let fill = resolve(document.fill, specializations: document.fillSpecializations, appearance: appearance)
+    if case .automatic? = fill {
+        if appearance == .dark { return .systemDark }
+        // The automatic light background depends on Composer's inferred
+        // artwork color. We cannot reproduce it from an unverified formula.
+        if appearance == .tinted {
+            return try backgroundFill(document: document, appearance: .light)
+        }
+        throw IconCompilerError.unsupported("Automatic light background: provide a light fill specialization")
+    }
+    guard let fill else { throw IconCompilerError.invalidDocument("Missing icon background fill") }
+    return fill
+}
